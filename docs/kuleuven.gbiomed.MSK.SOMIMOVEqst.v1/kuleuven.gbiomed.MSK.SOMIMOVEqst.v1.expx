<?xml version="1.0" encoding="UTF-8"?>
<experiment xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:noNamespaceSchemaLocation="https://files.labbench.io/xsd/6.0/experiment.xsd">

    <!-- (1) Controle van het deelnemers-ID -->
    <participant-validator regex="^S[0-9]{3}$|^TEST[0-9]{3}$"
                       advice="Geef een ID in de vorm SXXX (bv. S001), of TESTXXX voor testruns" />
    
    <!-- (2) Experimentele setup: welke toestellen er zijn -->
    <experimental-setup-variants default="SOMNIMOVEsetup">
        <experimental-setup id="SOMNIMOVEsetup" name="SOMNIMOVE QST setup (LabBench CPAR+ met VAS op tweede scherm)">
           <devices>
                <!-- (2a) Joystick: bediening van vragenlijsten -->
                <joystick id="joystick">
                    <map experimental-setup-id="questionnaire">
                        <button-assignment code="1" button="up" label="Omhoog" />
                        <button-assignment code="4" button="down" label="Omlaag" />
                        <button-assignment code="8" button="decrease" label="Verminderen" />
                        <button-assignment code="2" button="increase" label="Vermeerderen" />
                        <button-assignment code="16" button="previous" label="Vorige" />
                        <button-assignment code="32" button="next" label="Volgende" />
                    </map>
                    <map experimental-setup-id="image">
                        <button-assignment code="4" button="button-01" label="blauw" />
                        <button-assignment code="8" button="button-02" label="geel" />
                        <button-assignment code="1" button="button-03" label="rood" />
                        <button-assignment code="2" button="button-04" label="groen" />
                    </map>
                </joystick> 
                
                <!-- (2b) Cuff-algometer; de LabBench SCALE hangt aan zijn response-poort -->
                <cpar-plus id="cpar" />

                <!-- (2c) Tweede scherm voor de deelnemer -->
                <display id="display" normative-distance="40">
                    <typography active-colour="rgb(255,0,0)"
                                inactive-colour="rgb(16,16,16)"
                                foreground-colour="rgb(0,0,0)"
                                background-colour="rgb(255,255,255)" />
                    <configurations>
                        <!-- VAS tijdens de cuff-procedures, gestuurd door de SCALE via de CPAR+ -->
                        <visual-analogue-scale id="vas"
                            experimental-setup-id="vas"
                            length="10"
                            controller-device="cpar">
                            <anchors>
                                <modality text="Pijn" />
                                <bottom-anchor text="0 = geen pijn" />
                                <top-anchor text="10 = maximaal verdraagbare pijn" />
                            </anchors>
                        </visual-analogue-scale>

                        <!-- Instructies (afbeeldingen) voor de deelnemer -->
                        <image-display id="image"
                            experimental-setup-id="image"
                            background-colour="rgb(0,0,0)" />

                        <!-- Vragenlijsten, bediend met de joystick -->
                        <questionnaire id="questionnaire"
                            experimental-setup-id="questionnaire"
                            controller-device="joystick" />
                    </configurations>
                </display>
            </devices>

            <!-- (3) Koppeling toestellen -> instrumenten die procedures nodig hebben -->
            <device-mapping>
                <device-assignment instrument-name="PressureAlgometer" device-id="cpar" />
                <device-assignment instrument-name="Button"            device-id="joystick" />
                <device-assignment instrument-name="ImageDisplay"      device-id="display.image" />
                <device-assignment instrument-name="Questionnaire"     device-id="display.questionnaire" />
            </device-mapping>
        </experimental-setup>
    </experimental-setup-variants>
    
    <protocol>
        <languages>
            <language code="NL" name="Dutch" />
        </languages>

        <!-- (4) Sessies -->
        <sessions>
            <session id="T0" name="Baseline"/>
            <session id="T1" name="Post-interventie"/>
            <session id="T2" name="6 maanden follow-up"/>
        </sessions>
        <properties>
            <!--  Contents omitted for brevity -->
        </properties>
        <persistent-variables>
            <!--  Contents omitted for brevity -->
        </persistent-variables>        
        <variables>
            <variable name="StroopDisplayTime" value="1500" />
            <variable name="StroopColors" value="{'blauw': '#0000FF', 'geel': '#FFFF00', 'rood': '#FF0000', 'groen': '#00FF00'}" />
            <variable name="StroopWords"  value="{'b': 'BLAUW', 'y': 'GEEL', 'r': 'ROOD', 'g': 'GROEN'}" />
        </variables>
        <templates>            
                <includes>
                    <!--  Contents omitted for brevity -->
                </includes>
                <protocol-variables>
                    <!--  Contents omitted for brevity -->
                </protocol-variables>
                <template-variables>
                    <!--  Contents omitted for brevity -->
                </template-variables>
                <procedure-templates>
                    <!--  Contents omitted for brevity -->
                </procedure-templates>
                <assets>
                    <!--  Contents omitted for brevity --> 
                </assets>           
        </templates>
        <procedures>
            <!-- (1) Testmoment: datum en starttijd, in te vullen door de onderzoeker -->
            <questionnaire id="Testmoment"
                name="Testdatum en starttijd"
                session="T0"
                experimental-setup-id="image"
                control="operator">
                <content>
                    <time id="Start" title="Testdatum en starttijd"
                        instruction="Vul de datum en het startuur (uu:mm) van de meting in." />
                </content>
            </questionnaire>

            <!-- ===================== STROOP ===================== -->

            <!-- (Stroop 1) Oefenblok: 16 woorden (50 % congruent), ±1 min -->
            <stimulation-sequence id="STROOPoefen"
                name="Stroop - oefenblok"
                session="T0"
                experimental-setup-id="image"
                response-collection="yes-no"
                stimulus-update-rate="10000">

                <procedure-events complete="func: StroopScript.StroopEvaluate(tc)" />

                <properties>
                    <instructions default="Assets.Instructies.StroopInstructies_NL" override-results="false" />
                    <participant-instructions experimental-setup-id="image"
                        default="Assets.Instructies.StroopInstructies_NL" />
                </properties>

                <stimulation-scripts
                    initialize="True"
                    stimulate="func: StroopScript.StroopStimulate(tc,x)"
                    stimulus-description="Woord"
                    stimulus-unit="N/A">
                    <instrument name="ImageDisplay" interface="image-display" />
                </stimulation-scripts>

                <stimulation-pattern time-base="seconds">
                    <sequence iterations="1">
                        <sequence iterations="1" Tperiod="4" stimulate="false" />
                        <uniformly-distributed-sequence minTperiod="2" maxTperiod="2.5" iterations="8" />
                    </sequence>
                </stimulation-pattern>

                <!-- Naam = [kleur van de letters][betekenis van het woord]; b=blauw, y=geel, r=rood, g=groen -->
                <stimuli order="block-random">
                    <stimulus name="rood_rood" />
                    <stimulus name="groen_groen" />
                    <stimulus name="blauw_blauw" />
                    <stimulus name="geel_geel" />
                    <stimulus name="rood_groen" />
                    <stimulus name="groen_blauw" />
                    <stimulus name="blauw_geel" />
                    <stimulus name="geel_rood" />
                </stimuli>
            </stimulation-sequence>

            <!-- (Stroop 2) Echte taak: 72 woorden (50 % congruent), ±5 min -->
            <stimulation-sequence id="STROOP"
                name="Stroop"
                session="T0"
                experimental-setup-id="image"
                response-collection="yes-no"
                stimulus-update-rate="10000">

                <procedure-events complete="func: StroopScript.StroopEvaluate(tc)" />

                <dependencies>
                    <dependency id="STROOPoefen" />
                </dependencies>

                <stimulation-scripts
                    initialize="True"
                    stimulate="func: StroopScript.StroopStimulate(tc,x)"
                    stimulus-description="Woord"
                    stimulus-unit="N/A">
                    <instrument name="ImageDisplay" interface="image-display" />
                </stimulation-scripts>

                <stimulation-pattern time-base="seconds">
                    <sequence iterations="1">
                        <sequence iterations="1" Tperiod="4" stimulate="false" />
                        <uniformly-distributed-sequence minTperiod="2" maxTperiod="2.5" iterations="72" />
                    </sequence>
                </stimulation-pattern>

                <!-- Per blok van 24: 12 congruent (elke kleur 3x) en 12 incongruent (elke combinatie 1x) -->
                <stimuli order="block-random">
                    <stimulus name="rood_rood" count="3" />
                    <stimulus name="rood_groen" />
                    <stimulus name="rood_blauw" />
                    <stimulus name="rood_geel" />

                    <stimulus name="groen_rood" />
                    <stimulus name="groen_groen" count="3" />
                    <stimulus name="groen_blauw" />
                    <stimulus name="groen_geel" />

                    <stimulus name="blauw_rood" />
                    <stimulus name="blauw_groen" />
                    <stimulus name="blauw_blauw" count="3" />
                    <stimulus name="blauw_geel" />

                    <stimulus name="geel_rood" />
                    <stimulus name="geel_blauw" />
                    <stimulus name="geel_groen" />
                    <stimulus name="geel_geel" count="3" />
                </stimuli>
            </stimulation-sequence>

            <!-- (2) Testzijde: in te vullen door de onderzoeker -->
            <questionnaire id="Testzijde"
                name="Testzijde"
                session="T0"
                experimental-setup-id="image"
                control="operator">
                <content>
                    <boolean id="Zijde" title="Testzijde"
                        instruction="Vraag: 'Welk been is het meest aangedaan door uw artrose?' Bij gelijk: been met de meeste pijn in de afgelopen week."
                        true-label="Rechts" false-label="Links" />
                </content>
            </questionnaire>

            <!-- (3) Pre-test checklist: de deelnemer antwoordt met de joystick -->
            <questionnaire id="PreTestChecklist"
                name="Pre-test checklist"
                session="T0"
                experimental-setup-id="questionnaire"
                control="participant"
                progress-format="index">
                <content>
                    <boolean id="Q01" title="Alcohol"
                        instruction="Heeft u de afgelopen 24 uur alcohol gedronken?"
                        true-label="Ja" false-label="Nee" />
                    <numeric id="Q02" title="Alcohol"
                        instruction="Hoeveel glazen alcohol drinkt u gewoonlijk per week?">
                        <validation min="0" min-included="true" max="100" max-included="true" />
                    </numeric>
                    <boolean id="Q03" title="Cafeïne"
                        instruction="Heeft u de afgelopen 12 uur koffie, zwarte of groene thee, cola of energiedrank gedronken? (Cafeïnevrije koffie en kruidenthee tellen niet mee.)"
                        true-label="Ja" false-label="Nee" />
                    <numeric id="Q04" title="Cafeïne"
                        instruction="Hoeveel koppen koffie, zwarte of groene thee, glazen cola of energiedrank drinkt u gewoonlijk per dag?">
                        <validation min="0" min-included="true" max="30" max-included="true" />
                    </numeric>
                    <boolean id="Q05" title="Nicotine"
                        instruction="Heeft u de afgelopen 4 uur gerookt of andere nicotineproducten gebruikt (e-sigaret, nicotinekauwgom of -pleister)?"
                        true-label="Ja" false-label="Nee" />
                    <likert id="Q06" title="Nicotine"
                        instruction="Rookt u gewoonlijk of gebruikt u gewoonlijk nicotineproducten?">
                        <choice value="0" label="Nee" />
                        <choice value="1" label="Ja, af en toe" />
                        <choice value="2" label="Ja, dagelijks" />
                    </likert>
                    <boolean id="Q07" title="Pijnmedicatie"
                        instruction="Neemt u regelmatig pijnmedicatie, bijvoorbeeld elke dag of volgens een vast schema dat uw arts heeft voorgeschreven?"
                        true-label="Ja" false-label="Nee" />
                    <boolean id="Q08" title="Pijnmedicatie"
                        instruction="Heeft u de afgelopen 24 uur extra pijnmedicatie genomen, bovenop uw gewone medicatie? Dit is pijnmedicatie die u maar af en toe neemt, bijvoorbeeld wanneer uw pijn erger is (zoals paracetamol of ibuprofen)."
                        true-label="Ja" false-label="Nee" />
                    <boolean id="Q09" title="Fysieke activiteit"
                        instruction="Heeft u de afgelopen 24 uur een fysieke activiteit gedaan die zwaarder of ongewoner was dan normaal voor u?"
                        true-label="Ja" false-label="Nee" />
                </content>
            </questionnaire>

            <!-- (4) Familiarisatie: oefenramp 1, contralateraal been -->
            <algometry-stimulus-response id="FAM1"
                name="Familiarisatie ramp 1 (contralateraal)"
                session="T0"
                experimental-setup-id="vas"
                delta-pressure="1"
                pressure-limit="100"
                primary-cuff="1"
                second-cuff="false"
                stop-mode="stop-when-button-pressed"
                vas-pdt="0.1"
                conditioning-time="0">
                <properties>
                    <instructions default="Assets.Instructies.Familarisatie" override-results="false" />
                    <participant-instructions experimental-setup-id="image"
                        default="Assets.Instructies.Familarisatie" />
                </properties>
            </algometry-stimulus-response>
            
            <!-- (5) Familiarisatie: oefenramps 2 t.e.m. 5 -->
            <algometry-stimulus-response id="FAM2"
                name="Familiarisatie ramp 2 (contralateraal)"
                session="T0"
                experimental-setup-id="vas"
                delta-pressure="1"
                pressure-limit="100"
                primary-cuff="1"
                second-cuff="false"
                stop-mode="stop-when-button-pressed"
                vas-pdt="0.1"
                conditioning-time="0">
                <properties>
                    <time-constraint procedure-id="FAM1" min="10" time-reference="end" notification="true" />
                </properties>
                <dependencies>
                    <dependency id="FAM1" />
                </dependencies>
            </algometry-stimulus-response>

            <algometry-stimulus-response id="FAM3"
                name="Familiarisatie ramp 3 (contralateraal)"
                session="T0"
                experimental-setup-id="vas"
                delta-pressure="1"
                pressure-limit="100"
                primary-cuff="1"
                second-cuff="false"
                stop-mode="stop-when-button-pressed"
                vas-pdt="0.1"
                conditioning-time="0">
                <properties>
                    <time-constraint procedure-id="FAM2" min="10" time-reference="end" notification="true" />
                </properties>
                <dependencies>
                    <dependency id="FAM2" />
                </dependencies>
            </algometry-stimulus-response>

            <algometry-stimulus-response id="FAM4"
                name="Familiarisatie ramp 4 (contralateraal)"
                session="T0"
                experimental-setup-id="vas"
                delta-pressure="1"
                pressure-limit="100"
                primary-cuff="1"
                second-cuff="false"
                stop-mode="stop-when-button-pressed"
                vas-pdt="0.1"
                conditioning-time="0">
                <properties>
                    <time-constraint procedure-id="FAM3" min="10" time-reference="end" notification="true" />
                </properties>
                <dependencies>
                    <dependency id="FAM3" />
                </dependencies>
                <condition expression="abs(FAM3.PDT - FAM2.PDT) &gt;= 5" help="Wordt overgeslagen als de PDT van de laatste twee oefenramps minder dan 5 kPa verschilt" />
            </algometry-stimulus-response>

            <algometry-stimulus-response id="FAM5"
                name="Familiarisatie ramp 5 (contralateraal)"
                session="T0"
                experimental-setup-id="vas"
                delta-pressure="1"
                pressure-limit="100"
                primary-cuff="1"
                second-cuff="false"
                stop-mode="stop-when-button-pressed"
                vas-pdt="0.1"
                conditioning-time="0">
                <properties>
                    <time-constraint procedure-id="FAM4" min="10" time-reference="end" notification="true" />
                </properties>
                <dependencies>
                    <dependency id="FAM4" />
                </dependencies>
                <condition expression="abs(FAM3.PDT - FAM2.PDT) &gt;= 5 and abs(FAM4.PDT - FAM3.PDT) &gt;= 5" help="Wordt overgeslagen als de PDT van de laatste twee oefenramps minder dan 5 kPa verschilt" />
            </algometry-stimulus-response>

            <!-- (6) Experimentele ramp: cPDT / PVAS4 / cPTT, ipsilateraal been -->
            <algometry-stimulus-response id="EXP"
                name="cPDT/cPTT experimentele ramp (ipsilateraal)"
                session="T0"
                experimental-setup-id="vas"
                delta-pressure="1"
                pressure-limit="100"
                primary-cuff="1"
                second-cuff="false"
                stop-mode="stop-on-maximal-rating"
                vas-pdt="0.1"
                conditioning-time="0">
                <properties>
                    <instructions default="Assets.Instructies.Eigenlijke_test" override-results="false" />
                    <participant-instructions experimental-setup-id="image"
                        default="Assets.Instructies.Eigenlijke_test" />
                </properties>
                <dependencies>
                    <dependency id="FAM3" />
                </dependencies>
            </algometry-stimulus-response>

            <!-- (7) Temporal summation, ipsilateraal been -->
            <algometry-temporal-summation id="TS"
                name="Temporal summation (ipsilateraal)"
                session="T0"
                experimental-setup-id="vas"
                no-of-stimuli="12"
                pressure-static="1"
                pressure-stimulate="(EXP.PDT + EXP.PTT) / 2"
                primary-cuff="1"
                second-cuff="false"
                t-on="1"
                t-off="1">
                <properties>
                    <time-constraint procedure-id="EXP" min="180" time-reference="end" notification="true" />
                    <instructions default="Assets.Instructies.TS" override-results="false" />
                    <participant-instructions experimental-setup-id="image"
                        default="Assets.Instructies.TS" />
                </properties>
                <dependencies>
                    <dependency id="EXP" />
                </dependencies>
            </algometry-temporal-summation>

            <!-- (8) ===================== CPM ===================== -->

            <!-- (CPM 1) Baseline: cPDT + PVAS4, ipsilateraal been (cuff 1) -->
            <algometry-stimulus-response id="CPMbase"
                name="CPM 1 - baseline (ipsilateraal been)"
                session="T0"
                experimental-setup-id="vas"
                delta-pressure="1"
                pressure-limit="100"
                primary-cuff="1"
                second-cuff="false"
                stop-mode="stop-on-maximal-rating"
                vas-pdt="0.1"
                conditioning-time="0">
                <properties>
                    <time-constraint procedure-id="TS" min="180" time-reference="end" notification="true" />
                    <instructions default="Assets.Instructies.CPM_baseline" override-results="false" />
                    <participant-instructions experimental-setup-id="image"
                        default="Assets.Instructies.CPM_baseline" />
                </properties>
                <dependencies>
                    <dependency id="TS" />
                </dependencies>
            </algometry-stimulus-response>

            <!-- (CPM 2) Kalibratie conditioneringsstimulus: contralaterale arm (cuff 2),
                 max 80 kPa, onderzoeker zegt "Nu" bij VAS 6, deelnemer drukt op de stopknop -->
            <algometry-stimulus-response id="CPMcs"
                name="CPM 2 - kalibratie CS (contralaterale arm)"
                session="T0"
                experimental-setup-id="vas"
                delta-pressure="1"
                pressure-limit="80"
                primary-cuff="2"
                second-cuff="false"
                stop-mode="stop-on-maximal-rating"
                vas-pdt="0.1"
                conditioning-time="0">
                <properties>
                    <instructions default="Assets.Instructies.CPM_kalibratie_CS" override-results="false" />
                    <participant-instructions experimental-setup-id="image"
                        default="Assets.Instructies.CPM_kalibratie_CS" />
                </properties>
                <dependencies>
                    <dependency id="CPMbase" />
                </dependencies>
            </algometry-stimulus-response>

            <!-- (CPM 3) Parallel: arm (cuff 2) op CS-druk, tegelijk ramp op het been (cuff 1).
                 CS-druk = druk bij VAS 6 uit CPMcs; niet bereikt = hoogste gegeven druk -->
            <algometry-conditioned-pain-modulation id="CPMpar"
                name="CPM 3 - parallel (been tijdens CS op arm)"
                session="T0"
                experimental-setup-id="vas"
                conditional-pressure="CPMcs.GetPressureFromPerception(6) if CPMcs.IsScoreAvailable(6) else max(CPMcs.StimulationPressure)"
                delta-conditional-pressure="10"
                conditioning-time="10"
                delta-pressure="1"
                pressure-limit="100"
                primary-cuff="1"
                stop-mode="stop-on-maximal-rating"
                vas-pdt="0.1">
                <properties>
                    <instructions default="Assets.Instructies.CPM_parallel_sequentieel" override-results="false" />
                    <participant-instructions experimental-setup-id="image"
                        default="Assets.Instructies.CPM_parallel_sequentieel" />
                </properties>
                <dependencies>
                    <dependency id="CPMcs" />
                </dependencies>
            </algometry-conditioned-pain-modulation>

            <!-- (CPM 4) Sequentieel: meteen na CPM 3, CS uit, ramp op het been (cuff 1) -->
            <algometry-stimulus-response id="CPMseq"
                name="CPM 4 - sequentieel (been na CS)"
                session="T0"
                experimental-setup-id="vas"
                delta-pressure="1"
                pressure-limit="100"
                primary-cuff="1"
                second-cuff="false"
                stop-mode="stop-on-maximal-rating"
                vas-pdt="0.1"
                conditioning-time="0">
                <dependencies>
                    <dependency id="CPMpar" />
                </dependencies>
            </algometry-stimulus-response>
        </procedures>
        
        <assets>
            <file-asset id="Script" file="Script.py" />
            <file-asset id="Instructies" file="Instructies.zip" />
            <file-asset id="StroopScript" file="StroopScript.py" />
            <file-asset id="Roboto" file="Roboto-Regular.ttf" />
        </assets>
    </protocol>
         <post-actions>
        <!-- Alle ruwe data (curves, Stroop per woord) als back-up -->
        <export-data name="Ruwe data"
                     format="json"
                     location="L:\GBW-0044_MSK\0044_AlineVanStallen\SOMNIMOVE\LabBenchData"
                     filename="dynamic: '{s}.json'.format(s = Participant)" />

        <!-- Uitkomsten: één rij per deelnemer -->
        <export-to-csv name="Exporting session"
                       location="L:\GBW-0044_MSK\0044_AlineVanStallen\SOMNIMOVE\LabBenchData"
                       header="true"
                       separator=";"
                       culture="nl-BE"
                       filename="dynamic: '{s}.csv'.format(s = Participant)">

            <!-- Algemeen -->
            <item name="ProtocolID" value="EXP.ProtocolID" default="NA" />
            <item name="MachineName" value="EXP.MachineID" default="NA" />
            <item name="Testmoment" value="Testmoment.RecordingTime.ToString('yyyy-MM-dd HH:mm')" default="NA" />
            <item name="Testzijde" value="Testzijde.Zijde" default="NA" />

            <!-- Pre-test checklist -->
            <item name="Q01" value="PreTestChecklist.Q01" default="NA" />
            <item name="Q02" value="PreTestChecklist.Q02" default="NA" />
            <item name="Q03" value="PreTestChecklist.Q03" default="NA" />
            <item name="Q04" value="PreTestChecklist.Q04" default="NA" />
            <item name="Q05" value="PreTestChecklist.Q05" default="NA" />
            <item name="Q06" value="PreTestChecklist.Q06" default="NA" />
            <item name="Q07" value="PreTestChecklist.Q07" default="NA" />
            <item name="Q08" value="PreTestChecklist.Q08" default="NA" />
            <item name="Q09" value="PreTestChecklist.Q09" default="NA" />

            <!-- Familiarisatie (NA = ramp overgeslagen door de stopregel) -->
            <item name="FAM1PDT" value="int(FAM1.PDT * 10 + 0.5) / 10.0" default="NA" />
            <item name="FAM2PDT" value="int(FAM2.PDT * 10 + 0.5) / 10.0" default="NA" />
            <item name="FAM3PDT" value="int(FAM3.PDT * 10 + 0.5) / 10.0" default="NA" />
            <item name="FAM4PDT" value="int(FAM4.PDT * 10 + 0.5) / 10.0" default="NA" />
            <item name="FAM5PDT" value="int(FAM5.PDT * 10 + 0.5) / 10.0" default="NA" />

            <!-- Experimentele ramp -->
            <item name="EXPPDT" value="int(EXP.PDT * 10 + 0.5) / 10.0" default="NA" />
            <item name="EXPPTT" value="int(EXP.PTT * 10 + 0.5) / 10.0" default="NA" />
            <item name="EXPPVAS4" value="int(EXP.GetPressureFromPerception(4) * 10 + 0.5) / 10.0" default="NA" />

            <!-- Temporal summation -->
            <item name="TSdruk" value="int(TS.NominalStimulatingPressure * 10 + 0.5) / 10.0" default="NA" />
            <item name="TS01" value="int(TS.Responses[0] * 10 + 0.5) / 10.0" default="NA" />
            <item name="TS02" value="int(TS.Responses[1] * 10 + 0.5) / 10.0" default="NA" />
            <item name="TS03" value="int(TS.Responses[2] * 10 + 0.5) / 10.0" default="NA" />
            <item name="TS04" value="int(TS.Responses[3] * 10 + 0.5) / 10.0" default="NA" />
            <item name="TS05" value="int(TS.Responses[4] * 10 + 0.5) / 10.0" default="NA" />
            <item name="TS06" value="int(TS.Responses[5] * 10 + 0.5) / 10.0" default="NA" />
            <item name="TS07" value="int(TS.Responses[6] * 10 + 0.5) / 10.0" default="NA" />
            <item name="TS08" value="int(TS.Responses[7] * 10 + 0.5) / 10.0" default="NA" />
            <item name="TS09" value="int(TS.Responses[8] * 10 + 0.5) / 10.0" default="NA" />
            <item name="TS10" value="int(TS.Responses[9] * 10 + 0.5) / 10.0" default="NA" />
            <item name="TS11" value="int(TS.Responses[10] * 10 + 0.5) / 10.0" default="NA" />
            <item name="TS12" value="int(TS.Responses[11] * 10 + 0.5) / 10.0" default="NA" />
            <item name="TSeffect" value="int(((TS.Responses[9] + TS.Responses[10] + TS.Responses[11]) / 3 - (TS.Responses[2] + TS.Responses[3] + TS.Responses[4]) / 3) * 10 + (0.5 if (TS.Responses[9] + TS.Responses[10] + TS.Responses[11]) &gt;= (TS.Responses[2] + TS.Responses[3] + TS.Responses[4]) else -0.5)) / 10.0" default="NA" />

            <!-- CPM -->
            <item name="CPMbasePDT" value="int(CPMbase.PDT * 10 + 0.5) / 10.0" default="NA" />
            <item name="CPMbasePTT" value="int(CPMbase.PTT * 10 + 0.5) / 10.0" default="NA" />
            <item name="CPMbasePVAS4" value="int(CPMbase.GetPressureFromPerception(4) * 10 + 0.5) / 10.0" default="NA" />
            <item name="CPMcsPVAS6" value="int(CPMcs.GetPressureFromPerception(6) * 10 + 0.5) / 10.0" default="NA" />
            <item name="CPMcsDruk" value="int((CPMcs.GetPressureFromPerception(6) if CPMcs.IsScoreAvailable(6) else CPMcs.PTT) * 10 + 0.5) / 10.0" default="NA" />
            <item name="CPMparPDT" value="int(CPMpar.PDT * 10 + 0.5) / 10.0" default="NA" />
            <item name="CPMparPTT" value="int(CPMpar.PTT * 10 + 0.5) / 10.0" default="NA" />
            <item name="CPMparPVAS4" value="int(CPMpar.GetPressureFromPerception(4) * 10 + 0.5) / 10.0" default="NA" />
            <item name="CPMseqPDT" value="int(CPMseq.PDT * 10 + 0.5) / 10.0" default="NA" />
            <item name="CPMseqPTT" value="int(CPMseq.PTT * 10 + 0.5) / 10.0" default="NA" />
            <item name="CPMseqPVAS4" value="int(CPMseq.GetPressureFromPerception(4) * 10 + 0.5) / 10.0" default="NA" />

            <!-- Stroop (samenvatting berekend door StroopScript.py) -->
            <item name="StroopOefenAcc" value="STROOPoefen.Annotations['accuratesse']" default="NA" />
            <item name="StroopAcc" value="STROOP.Annotations['accuratesse']" default="NA" />
            <item name="StroopAccCon" value="STROOP.Annotations['accCongruent']" default="NA" />
            <item name="StroopAccIncon" value="STROOP.Annotations['accIncongruent']" default="NA" />
            <item name="StroopFoutInterf" value="STROOP.Annotations['foutInterferentie']" default="NA" />
            <item name="StroopRTcon" value="STROOP.Annotations['rtCongruent']" default="NA" />
            <item name="StroopRTincon" value="STROOP.Annotations['rtIncongruent']" default="NA" />
            <item name="StroopInterf" value="STROOP.Annotations['interferentie']" default="NA" />
            <item name="StroopRelInterf" value="STROOP.Annotations['relInterferentie']" default="NA" />
            <item name="StroopIEScon" value="STROOP.Annotations['iesCongruent']" default="NA" />
            <item name="StroopIESincon" value="STROOP.Annotations['iesIncongruent']" default="NA" />
            <item name="StroopIESinterf" value="STROOP.Annotations['iesInterferentie']" default="NA" />
            <item name="StroopTeSnel" value="STROOP.Annotations['aantalTeSnel']" default="NA" />
            <item name="StroopGeenAntw" value="STROOP.Annotations['aantalGeenAntwoord']" default="NA" />
        </export-to-csv>
    </post-actions>
</experiment>